{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matchstick",
  "version": "0.3.0",
  "identifier": "com.harshal-patel.matchstick",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Matchstick",
        "width": 848,
        "height": 648,
        "shadow": false,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "Copyright © 2026 Harshal Patel. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Spotlight-like search launcher for Windows",
    "longDescription": "Matchstick is a fast, native desktop search launcher. Press Ctrl+Space from anywhere to instantly search and launch apps, files, and folders. Features fuzzy search, smart ranking, a built-in calculator, and a polished dark-theme UI.",
    "homepage": "https://github.com/HarshalPatel1972/win-light",
    "publisher": "Harshal Patel",
    "licenseFile": "../LICENSE",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": [
          "English"
        ],
        "startMenuFolder": "Matchstick",
        "compression": "lzma",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/HarshalPatel1972/win-light/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1RDFCRTY4NzU3NEZBM0QKUldROStuUjFhTDdSbFVZY2J0TzBvdWwzS3B6bE1nMWg1SEg3UWtNTDJBOThubmRwVk4rVUZuMlkK"
    }
  }
}
